# Gemini auth — pick one. Chat/STT/TTS need credentials; engine tests do not.

# Option A (preferred): Google Cloud user login + ADC for Vertex AI
#   gcloud auth login --update-adc
#   gcloud config set project YOUR_GCP_PROJECT
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=1

# Option B: Gemini Developer API key (alias: GOOGLE_API_KEY)
GEMINI_API_KEY=

# Chat/tool model. Default is Flash; numbers come from deterministic engines.
# Override to gemini-2.5-pro if narration quality needs a bump.
NAVAID_MODEL=gemini-2.5-flash

# Set to 1 to skip government HTTP; use the local DuckDB snapshot only.
NAVAID_OFFLINE=0

# Extra CORS origins for a split frontend (GitHub Pages is already allowed via regex).
# NAVAID_CORS_ORIGINS=https://example.netlify.app
